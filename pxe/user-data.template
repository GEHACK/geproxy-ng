#cloud-config
autoinstall:
  version: 1
  proxy: http://_gateway:3142
  kernel:
    flavor: hwe
  shutdown: reboot
  identity:
    hostname: ${MACHINE_HOSTNAME:-machine}
    password: ${MACHINE_PASSWORD:-'$2a$12$6EyKyPDuHQcHIF7Abawva.pCLQhGs0r/3NybeiMVgaKTDPbm.a7b6'}
    realname: ${MACHINE_USERNAME:-contestadmin}
    username: ${MACHINE_USERNAME:-contestadmin}
  storage:
    grub:
      reorder_uefi: true
      update_nvram: true
      reorder_uefi_force_fallback: true
    config:
      # disk
      - type: disk
        id: disk-sda
        ptable: gpt
        wipe: superblock-recursive
        name: ''
        preserve: false
        grub_device: true

      # physical partitions
      - type: partition
        id: partition-0
        number: 1
        device: disk-sda
        size: 1GB
        flag: boot
        grub_device: true
        preserve: false

      - type: partition
        id: partition-1
        number: 2
        size: -1
        wipe: superblock
        device: disk-sda
        preserve: false

      # lvm
      - type: lvm_volgroup
        id: lvm_volgroup-0
        name: ubuntu-vg
        devices:
          - partition-1
        preserve: false

      - type: lvm_partition
        id: lvm_partition-0
        size: -1
        name: ubuntu-lv
        volgroup: lvm_volgroup-0
        wipe: superblock
        preserve: false

      # formats
      - type: format
        id: format-0
        fstype: vfat
        volume: partition-0
        preserve: false

      - type: format
        id: format-1
        fstype: ext4
        volume: lvm_partition-0
        preserve: false

      # mounts
      - type: mount
        id: mount-0
        path: /boot/efi
        device: format-0

      - type: mount
        id: mount-1
        path: /
        device: format-1
  ssh:
    allow-pw: false
    install-server: true
    authorized-keys: